# ================================
# PRODUCTION ENVIRONMENT VARIABLES
# ================================
# For Docker VPS deployments, see DOCKER_VPS_DEPLOYMENT.md + docker-compose.yml
#
# Critical for Docker + custom domain:
#   - SERVER_URL and CLIENT_URL must be the public https://yourdomain.com
#     (affects audio file URLs returned to users, emails, CORS, etc.)
#   - Use the root .env + docker-compose build args for NEXT_PUBLIC_* (see docs)
#
# MONGODB_URI: Use Atlas or "mongodb://host.docker.internal:27017/voiceforge" when Mongo is on the VPS host.
#
# NODE_ENV=production
# PORT=5000
# CLIENT_URL=https://yourdomain.com
# SERVER_URL=https://yourdomain.com
# MONGODB_URI=mongodb://... (your production MongoDB)
# JWT_ACCESS_SECRET=<64+ random chars>
# JWT_REFRESH_SECRET=<64+ random chars>
# XAI_API_KEY=your-xai-api-key
# ... other keys as needed
# ================================

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/voiceforge

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# xAI Text-to-Speech
XAI_API_KEY=your-xai-api-key
XAI_TEAM_ID=your-xai-team-id
XAI_TTS_MODEL=tts-1
XAI_TTS_URL=https://api.x.ai/v1/tts
XAI_DEFAULT_VOICE_ID=Eve
XAI_DEFAULT_LANGUAGE=en
XAI_DEFAULT_CODEC=mp3
XAI_DEFAULT_SAMPLE_RATE=44100
XAI_DEFAULT_BIT_RATE=128000
VOICE_PREVIEW_TEXT=Welcome to our AI voice platform. Create natural sounding speech in seconds.
# 2,380 credits = 1,190 characters = $0.01 USD worth (50% split, $4.20/1M chars)
WELCOME_CREDITS=2380
DEFAULT_WELCOME_CREDIT_USD=0.01

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary (optional — local disk used when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=voiceforge

# AWS S3 (alternative to Cloudinary)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

STORAGE_PROVIDER=local

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=

# Email Configuration (Namecheap Private Email)
# ==============================================
# NOTE: If you get "authentication failed" error, try Option 2 below
#
# Option 1: SSL (Port 465) - Default
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@voiceforgeai.site
# SMTP_PASS=your-password-here
# EMAIL_FROM=VoiceForge AI <support@voiceforgeai.site>
#
# Option 2: STARTTLS (Port 587) - Use if port 465 fails
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=support@voiceforgeai.site
# SMTP_PASS=your-password-here
# EMAIL_FROM=VoiceForge AI <support@voiceforgeai.site>

# Active Configuration (copy from above and uncomment)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@voiceforgeai.site
SMTP_PASS=iq4ihY99.
EMAIL_FROM=VoiceForge AI <support@voiceforgeai.site>

# Legacy Resend (optional fallback)
RESEND_API_KEY=

# App
PASSWORD_RESET_EXPIRES_MINUTES=60
MAX_UPLOAD_MB=25
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
