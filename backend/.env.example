NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/voiceforge

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# xAI Text-to-Speech
XAI_API_KEY=your-xai-api-key
XAI_TTS_URL=https://api.x.ai/v1/tts
XAI_DEFAULT_VOICE_ID=Eve
XAI_DEFAULT_LANGUAGE=en
XAI_DEFAULT_CODEC=mp3
XAI_DEFAULT_SAMPLE_RATE=44100
XAI_DEFAULT_BIT_RATE=128000

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary (optional — local disk used when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=voiceforge

# AWS S3 (alternative to Cloudinary)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

STORAGE_PROVIDER=local

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Resend
RESEND_API_KEY=
EMAIL_FROM=VoiceForge AI <noreply@voiceforge.ai>

# App
PASSWORD_RESET_EXPIRES_MINUTES=60
MAX_UPLOAD_MB=25
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
