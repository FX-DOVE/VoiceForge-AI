# Docker Compose environment (root level)
# Copy to .env (in same directory as docker-compose.yml) for easy variable interpolation
#
# This file is loaded automatically by modern Docker Compose.
#
# Most important: set your real domain so the Next.js build bakes the correct
# canonical URLs, sitemaps, OpenGraph tags, and middleware redirects.

DOMAIN=yourdomain.com

# You can also add other compose-level vars here if you extend docker-compose.yml
# EXAMPLE_EXTRA=foo
