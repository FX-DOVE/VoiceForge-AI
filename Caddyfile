# Caddyfile for VoiceForge AI — Docker VPS (Caddy as reverse proxy)
#
# This is the production configuration for reliable Docker networking.
#
# IMPORTANT:
# - Use `handle /api/*` (NOT handle_path) so the /api prefix is preserved when proxying.
# - All services communicate over the internal Docker network using service names
#   (frontend, api, etc.).
# - Only Caddy publishes ports 80/443 on the host.

{
    admin off
    auto_https on
}

voiceforgeai.site, www.voiceforgeai.site {
    # Basic security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Allow reasonably large uploads (voice samples, etc.)
    request_body {
        max_size 50MB
    }

    # === API routes - keep the /api prefix when forwarding ===
    handle /api/* {
        reverse_proxy api:5000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {proxy}
            header_up X-Forwarded-Proto {scheme}

            transport http {
                read_timeout 300s
                write_timeout 300s
            }
        }
    }

    # === Uploaded audio / generated files ===
    handle /uploads/* {
        reverse_proxy api:5000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
        }
        header {
            Cache-Control "public, max-age=2592000, immutable"
        }
    }

    # === Everything else goes to the Next.js frontend ===
    handle {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {proxy}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
